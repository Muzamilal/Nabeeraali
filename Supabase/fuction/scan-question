async function fetchImageAsBase64(url: string): Promise<{ data: string; mimeType: string }> {
  const response = await fetch(url);
  if (!response.ok) {
    throw new Error(`Failed to fetch image: ${response.status}`);
  }
  const contentType = response.headers.get("content-type") || "image/jpeg";
  const arrayBuffer = await response.arrayBuffer();
  const bytes = new Uint8Array(arrayBuffer);
  let binary = "";
  for (let i = 0; i < bytes.length; i++) {
    binary += String.fromCharCode(bytes[i]);
  }
  const base64 = btoa(binary);
  return { data: base64, mimeType: contentType };
}

Deno.serve(async (req: Request) => {
  if (req.method === "OPTIONS") {
    return new Response(null, { status: 200, headers: corsHeaders });
  }

  try {
    const { imageUrl } = await req.json();

    if (!imageUrl) {
      return new Response(
        JSON.stringify({ error: "Image URL is required" }),
        { status: 400, headers: { ...corsHeaders, "Content-Type": "application/json" } }
      );
    }

    const geminiKey = Deno.env.get("GEMINI_API_KEY");

    let questions: QuizQuestion[] = [];

    if (geminiKey) {
      const genAI = new GoogleGenerativeAI(geminiKey);
      const model = genAI.getGenerativeModel({
        model: "gemini-2.5-flash",
        generationConfig: {
          temperature: 0.7,
          maxOutputTokens: 4096,
          responseMimeType: "application/json",
        },
      });

      const imageData = await fetchImageAsBase64(imageUrl);

      const prompt = `You are an expert at creating MDCAT-style quiz questions from educational content. Analyze the provided image and extract or generate quiz questions based on the content visible in the image.

Return ONLY valid JSON in this exact format:
{
  "questions": [
    {
      "question_text": "The question text here",
      "options": ["Option A", "Option B", "Option C", "Option D"],
      "correct_answer": 0,
      "explanation": "A clear explanation of why the correct answer is right and why the others are wrong."
    }
  ]
}

Rules:
- Generate 5-10 questions based on the image content
- The correct_answer is a 0-indexed integer (0=A, 1=B, 2=C, 3=D)
- Each question must have exactly 4 options
- Include a clear, concise explanation for each answer
- If the image contains questions, extract and format them
- If the image contains study material, generate questions from it
- Focus on MDCAT/medical entrance exam topics when relevant`;

      const result = await model.generateContent([
        { text: prompt },
        {
          inlineData: {
            mimeType: imageData.mimeType,
            data: imageData.data,
          },
        },
      ]);

      const responseText = result.response.text();

      if (responseText) {
        try {
          const parsed = JSON.parse(responseText);
          if (parsed.questions && Array.isArray(parsed.questions)) {
            questions = parsed.questions.filter(
              (q: unknown): q is QuizQuestion => {
                const question = q as Partial<QuizQuestion>;
                return (
                  typeof question.question_text === "string" &&
                  Array.isArray(question.options) &&
                  question.options.length === 4 &&
                  typeof question.correct_answer === "number" &&
                  typeof question.explanation === "string"
                );
              }
            );
          }
        } catch {
          const jsonMatch = responseText.match(/\{[\s\S]*\}/);
          if (jsonMatch) {
            const parsed = JSON.parse(jsonMatch[0]);
            if (parsed.questions && Array.isArray(parsed.questions)) {
              questions = parsed.questions.filter(
                (q: unknown): q is QuizQuestion => {
                  const question = q as Partial<QuizQuestion>;
                  return (
                    typeof question.question_text === "string" &&
                    Array.isArray(question.options) &&
                    question.options.length === 4 &&
                    typeof question.correct_answer === "number" &&
                    typeof question.explanation === "string"
                  );
                }
              );
            }
          }
        }
      }
    }

    if (questions.length === 0) {
      questions = sampleQuestions;
    }

    return new Response(
      JSON.stringify({ questions }),
      { headers: { ...corsHeaders, "Content-Type": "application/json" } }
    );
  } catch (err) {
    console.error("Scan error:", err);
    return new Response(
      JSON.stringify({ error: err.message }),
      { status: 500, headers: { ...corsHeaders, "Content-Type": "application/json" } }
    );
  }
});

